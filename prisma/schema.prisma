generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Define schema models and enums for Role and ApprovalStatus
enum Role {
  SUPER_ADMIN
  RECRUITER
  EMPLOYEE
  CANDIDATE
  SUPPORT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String         @id @default(uuid())
  name      String
  email     String         @unique
  password  String
  role      Role
  status    ApprovalStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}