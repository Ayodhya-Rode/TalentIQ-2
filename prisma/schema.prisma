generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Define schema models and enums for Role and ApprovalStatus
enum Role {
  SUPER_ADMIN
  RECRUITER
  EMPLOYEE
  CANDIDATE
  SUPPORT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String         @id @default(uuid())
  name      String
  email     String         @unique
  password  String
  role      Role
  status    ApprovalStatus @default(PENDING)
  employeeProfile EmployeeProfile?
  candidateProfile CandidateProfile?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

// SUPER_ADMIN created categories
model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  employeeCategories EmployeeCategory[]
}

// to creates EmployeeProfile
model EmployeeProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  education   String?
  skills      String?
  location    String?
  experience  String?
  company     String?
  designation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories  EmployeeCategory[]
  bookings Booking[]
  slots       Slot[]
}

model EmployeeCategory {
  id                String          @id @default(uuid())
  employeeProfileId String
  categoryId        String

  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([employeeProfileId, categoryId])
}

model Slot {
  id                String          @id @default(uuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id])
  date              DateTime
  startTime         DateTime
  endTime           DateTime
  status            SlotStatus      @default(OPEN)
  createdAt         DateTime        @default(now())

  booking Booking?

  @@unique([employeeProfileId, startTime])
}

enum SlotStatus {
  OPEN
  BOOKED
}


//CandidateProfile related model
model CandidateProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  education   String?
  skills      String?
  location    String?
  designation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects     Project[]
  certificates Certificate[]
  bookings Booking[]
}

model Project {
  id                 String   @id @default(uuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  title       String
  description String?
  link        String?
  date        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Certificate {
  id                 String   @id @default(uuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  title       String
  description String?
  link        String?
  date        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  EXPIRED
}

enum PayoutStatus {
  NONE
  PENDING
  PAID
}

model Booking {
  id                 String   @id @default(uuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  employeeProfileId  String
  employeeProfile    EmployeeProfile  @relation(fields: [employeeProfileId], references: [id])
  slotId             String   @unique
  slot               Slot     @relation(fields: [slotId], references: [id])

  amount             Int      @default(100)
  status             BookingStatus @default(PENDING_PAYMENT)

  razorpayOrderId    String?  @unique
  razorpayPaymentId  String?
  razorpaySignature  String?

  employeeConfirmedAt  DateTime?
  candidateConfirmedAt DateTime?

  payoutStatus       PayoutStatus @default(NONE)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}